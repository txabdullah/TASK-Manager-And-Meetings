# Copy to .env next to docker-compose.prod.yml and adjust values.
# Never commit real secrets.

SECRET_KEY=generate-a-long-random-string
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

POSTGRES_USER=appuser
POSTGRES_PASSWORD=use-a-strong-password
POSTGRES_DB=taskmanager

# Optional: override full URL (defaults are built from POSTGRES_* above)
# DATABASE_URL=postgresql://appuser:password@db:5432/taskmanager

WEB_PORT=8000

# HTTPS behind reverse proxy
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

DEFAULT_FROM_EMAIL=noreply@yourdomain.com
